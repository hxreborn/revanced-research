# ============================================================================
# DECOMPILATION OUTPUTS (CRITICAL: Never commit these - repo inflation!)
# ============================================================================
# These are generated during APK reverse engineering and can be 100MB+ each.
# Tools: apktool, jadx, baksmali
decompiled-jadx/
decompiled-smali-full/
apps/**/apktool/
apps/**/apktool-output/
apps/**/jadx/
apps/**/jadx-output/
apps/**/jadx-badcode/
apps/**/jadx-deobf/
apps/**/indices/
apps/**/smali-tests/
apps/**/tiktok-patched-decompiled/
frida-scripts/trace-outputs/

# ============================================================================
# APK ARTIFACTS & BUILD OUTPUTS
# ============================================================================
*.apk                                  # APK binaries (tracked as .sha256/.info)
*.ap_                                  # Android compiled resources
*.dex                                  # Dalvik bytecode (except referenced smali)
*.idsig                                # APK signature metadata
apps/**/revanced-builds/               # Local patch compilation artifacts

# ============================================================================
# LOGS & TEMPORARY FILES
# ============================================================================
*.log                                  # All log files
hs_err_*.log                          # JVM crash dumps

# APK artifacts (only metadata tracked)
apps/**/apks/**/*.apk
apps/**/apks/**/*.ap_
!apps/**/apks/**/*.info
!apps/**/apks/**/*.sha256
apps/**/apks/**/apktool*/
apps/**/apks/**/check-unsigned-smali/
apps/**/apks/**/jars/
apps/**/apks/**/lbt-search/
apps/**/apks/**/smali*/
apps/**/apks/**/stock-check/
apps/**/apks/**/trill_analysis/
apps/**/apks/**/verify-*/
apps/**/downloads/**/logs/
apps/**/downloads/**/FINDINGS.md

com.ss.android.ugc.trill-patched-temporary-files/
com.ss.android.ugc.trill-patched-fixed-temporary-files/
com.ss.android.ugc.trill-patched-v2-temporary-files/

# Cryptographic signing keys (NEVER commit these)
*.keystore
*.jks
*.p12
*.pfx
*.key
*.pem

# Archived documentation
.archive/

# PR drafts and local documentation (not committed)
**/PR.md
**/PR_TRACKING_NOTES.md

# ReVanced build outputs
revanced-src/**/*.apk
revanced-src/**/*.ap_

# Generated scripts and analysis
AGENTS.md
*_bruteforce.sh
*_verification.sh
comprehensive_verification.sh
verification-checklist.txt

# ============================================================================
# SYSTEM & TEMPORARY
# ============================================================================
.DS_Store                              # macOS directory metadata
.metadata_never_index                  # macOS cache
Thumbs.db                              # Windows thumbnails
.gradle/                               # Gradle build cache
.idea/                                 # IntelliJ IDEA settings
.vscode/                               # VS Code settings
*.swp                                  # Vim swap files
*.swo                                  # Vim swap files
*~                                     # Backup files
.env                                   # Environment variables (secrets)
.env.local                             # Local environment overrides

# ============================================================================
# LARGE BINARY & BUILD ARTIFACTS
# ============================================================================
# These patterns prevent accidentally committing large binaries
*.so                                   # Native shared objects (can be 10MB+)
*.a                                    # Static libraries
*.o                                    # Object files
*.jar                                  # Java archives (except tracked)
build/                                 # Build directories
dist/                                  # Distribution artifacts
target/                                # Maven target
.m2/                                   # Maven cache
