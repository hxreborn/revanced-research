#!/bin/bash
# Pre-commit hook: Block commits containing decompiled APK artifacts

set -e

# Patterns to block
BLOCKED_PATTERNS=(
    "apps/*/apks/*/apktool/"
    "apps/*/apks/*/jadx"
    "apps/*/apks/*/smali"
    "*.apk"
    "*.dex"
)

STAGED_FILES=$(git diff --cached --name-only)

for pattern in "${BLOCKED_PATTERNS[@]}"; do
    if echo "$STAGED_FILES" | grep -q "$pattern"; then
        echo "❌ COMMIT BLOCKED: Decompiled APK files detected!"
        echo "Blocked pattern: $pattern"
        echo ""
        echo "These files should NOT be committed:"
        echo "$STAGED_FILES" | grep "$pattern" || true
        echo ""
        echo "✓ Only commit:"
        echo "  - apps/**/apks/**/*.sha256"
        echo "  - apps/**/apks/**/*.info"
        echo "  - apps/**/*/files/*.smali (reference files only)"
        echo ""
        exit 1
    fi
done

exit 0
