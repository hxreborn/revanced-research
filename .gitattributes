# Mark decompilation outputs as generated (don't count in stats)
*.smali linguist-generated=true
apps/**/*.smali linguist-generated=true

# Binary files
apps/**/*.dex linguist-binary
revanced-src/**/*.apk linguist-binary

# Explicitly identify source files
*.js linguist-language=JavaScript
*.sh linguist-language=Shell
*.md linguist-language=Markdown
